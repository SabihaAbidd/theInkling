fastapi = ">=0.115.0"
uvicorn = ">=0.30.0"
python-dotenv = ">=1.2.1"
langchain = ">=1.0.0"
langchain-groq = ">=1.0.0"
langgraph = ">=1.0.0"
langsmith = ">=0.4.0"
celery = {version = ">=5.4.0", extras = ["redis"]}
